# Run node scripts/init-demo.mjs; it creates ignored .env with generated credentials.
COMPOSE_PROJECT_NAME=aerosynapse
HOST_BIND_IP=127.0.0.1
FRONTEND_PORT=8080
API_PORT=5080
INTELLIGENCE_PORT=8000
POSTGRES_DB=aerosynapse
POSTGRES_USER=aerosynapse
POSTGRES_PASSWORD=
ASPNETCORE_ENVIRONMENT=Development
API_LOG_LEVEL=Information
APPLY_MIGRATIONS=true
SEED_SYNTHETIC_DATA=true
SIMULATION_WORKER_ENABLED=true
OPERATIONS_ENABLED=true
OPERATIONS_BROADCAST_MILLISECONDS=500
OPERATIONS_EVENTS_PER_BATCH=32
OPERATIONS_ENGINE_POLL_MILLISECONDS=1000
# Server-only fictional accounts, disabled until all passwords are supplied.
# Run node scripts/init-demo.mjs to generate local credentials in ignored .env.
IDENTITY_DEMO_ENABLED=false
IDENTITY_DEMO_VIEWER_PASSWORD=
IDENTITY_DEMO_OPERATOR_PASSWORD=
IDENTITY_DEMO_ADMIN_PASSWORD=
IDENTITY_SESSION_MINUTES=30
# Append-only operational evidence; controlled expiry only, no delete API.
AUDIT_RETENTION_DAYS=90
SECURITY_READ_PER_MINUTE=600
SECURITY_WRITE_PER_MINUTE=120
SECURITY_OPTIMIZATION_PER_MINUTE=20
SECURITY_MAX_JSON_BYTES=2097152
APP_ENV=development
INTELLIGENCE_LOG_LEVEL=info
SIMULATION_TIMEOUT_SECONDS=10
SIMULATION_RECONCILIATION_SECONDS=120
# Provisional warm-engine demo budget; team agreement is still pending.
SIMULATION_DEMO_BUDGET_MS=5000
# Research predictor (synthetic data only): enabled or disabled.
QUEUE_ML_PREDICTOR=disabled
# Optional synthetic baggage twin; shared by Intelligence and frontend.
BAGGAGE_TWIN_ENABLED=false
# Isolated synthetic airside handling planner; shared by Intelligence and frontend.
AIRSIDE_TWIN_ENABLED=false
# Optional estimated energy analytics; public frontend and Intelligence share this flag.
ENERGY_ANALYTICS_ENABLED=false
# Optional server-side Ollama. No model download occurs automatically.
COPILOT_ENABLED=false
COPILOT_ENDPOINT=http://host.docker.internal:11434/api/chat
COPILOT_MODEL=
COPILOT_API_KEY=
COPILOT_TIMEOUT_SECONDS=8

# Live AI agent: Gemini chooses among the algorithm's options during a run. Keep the key local; never commit it.
GEMINI_API_KEY=
AGENT_MODEL=gemini-2.5-flash
# Explicit transcript saves only; default one day, hard maximum one week.
COPILOT_TRANSCRIPT_RETENTION_HOURS=24
COPILOT_TRANSCRIPT_MAX_HOURS=168
# Public browser configuration. No secrets belong in these values.
FRONTEND_API_BASE_URL=/api
FRONTEND_INTELLIGENCE_BASE_URL=/intelligence
