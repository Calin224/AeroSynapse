        "errorCount",
        "assessed",
        "routes",
        "flights",
        "journeys",
        "offset",
        "returnedCount",
        "hasMore"
      ]
    },
    "RoutedSimulationRequest": {
      "type": "object",
      "description": "Version 1 queue simulation input, copied from frozen inputs. No live database references are resolved by validation.",
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "1.0",
          "description": "Wire protocol version; every envelope must explicitly provide it."
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "scenarioId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "scenarioRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Captured scenario revision."
        },
        "layoutVersionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "startsAtUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
          "description": "Gregorian UTC timestamp, uppercase T/Z, at most 6 fractional digits; no leap seconds."
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "IANA display time zone, e.g. UTC or Europe/Bucharest; all instants stay UTC."
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080,
          "description": "Simulation horizon in minutes, 1 minute = 60 seconds."
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "Explicit reproducibility seed; no implicit default in v1."
        },
        "passengerCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Total demand; arrivals stop when this count is reached."
        },
        "arrivalRatePerMinute": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "description": "Passengers entering the simulation per minute."
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Checkpoint"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "passengerGeneration": {
          "$ref": "#/$defs/PassengerGenerationRequest"
        },
        "navigation": {
          "$ref": "#/$defs/NavigationInput"
        }
      },
      "required": [
        "contractVersion",
        "runId",
        "scenarioId",
        "scenarioRevision",
        "layoutVersionId",
        "startsAtUtc",
        "timeZone",
        "durationMinutes",
        "seed",
        "passengerCount",
        "arrivalRatePerMinute",
        "checkpoints",
        "passengerGeneration",
        "navigation"
      ]
    },
