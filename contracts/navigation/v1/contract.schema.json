{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerosynapse.example/contracts/navigation/1.0/contract.schema.json",
  "title": "Navigation definitions; exported with the v1 and passenger definitions",
  "$defs": {
    "NavigationNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kind": {
          "type": "string",
          "enum": [
            "Entrance",
            "Walkway",
            "CheckIn",
            "Security",
            "PassportControl",
            "Gate",
            "Lounge",
            "BaggageClaim",
            "Stairs",
            "Elevator"
          ]
        },
        "x": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "z": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "isActive": {
          "type": "boolean"
        },
        "isStepFree": {
          "type": "boolean"
        },
        "requiredTags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "x",
        "y",
        "z",
        "isActive",
        "isStepFree",
        "requiredTags"
      ]
    },
    "NavigationEdge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "fromZoneId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "toZoneId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "distanceMeters": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "travelSeconds": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 604800
        },
        "isBidirectional": {
          "type": "boolean"
        },
        "isActive": {
          "type": "boolean"
        },
        "isStepFree": {
          "type": "boolean"
        },
        "requiredTags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "fromZoneId",
        "toZoneId",
        "distanceMeters",
        "travelSeconds",
        "isBidirectional",
        "isActive",
        "isStepFree",
        "requiredTags"
      ]
    },
    "NavigationGraph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NavigationNode"
          },
          "minItems": 1,
          "maxItems": 2000
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NavigationEdge"
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "nodes",
        "edges"
      ]
    },
    "NavigationBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resourceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "zoneId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        }
      },
      "required": [
        "resourceId",
        "zoneId"
      ]
    },
    "NavigationAccessProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groupKind": {
          "type": "string",
          "enum": [
            "solo",
            "family",
            "business",
            "tour"
          ]
        },
        "requireStepFree": {
          "type": "boolean"
        },
        "accessTags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "forbiddenZoneIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "description": "Nonempty UUID in lowercase canonical D format."
          },
          "minItems": 0,
          "maxItems": 2000
        },
        "walkingMultiplier": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10
        }
      },
      "required": [
        "groupKind",
        "requireStepFree",
        "accessTags",
        "forbiddenZoneIds",
        "walkingMultiplier"
      ]
    },
    "NavigationConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "navigationVersion": {
          "type": "string",
          "const": "1.0"
        },
        "graph": {
          "$ref": "#/$defs/NavigationGraph"
        },
        "checkpointBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NavigationBinding"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "gateBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NavigationBinding"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "accessProfiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NavigationAccessProfile"
          },
          "minItems": 1,
          "maxItems": 4
        },
        "closedZoneIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "description": "Nonempty UUID in lowercase canonical D format."
          },
          "minItems": 0,
          "maxItems": 2000
        },
        "closedEdgeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "description": "Nonempty UUID in lowercase canonical D format."
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "navigationVersion",
        "graph",
        "checkpointBindings",
        "gateBindings",
        "accessProfiles",
        "closedZoneIds",
        "closedEdgeIds"
      ]
    },
    "NavigationFlightGate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flightId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "gateId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        }
      },
      "required": [
        "flightId",
        "gateId"
      ]
    },
    "NavigationInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "navigationVersion": {
          "type": "string",
          "const": "1.0"
        },
        "graph": {
          "$ref": "#/$defs/NavigationGraph"
        },
        "checkpointBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NavigationBinding"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "gateBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NavigationBinding"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "accessProfiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NavigationAccessProfile"
          },
          "minItems": 1,
          "maxItems": 4
        },
        "closedZoneIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "description": "Nonempty UUID in lowercase canonical D format."
          },
          "minItems": 0,
          "maxItems": 2000
        },
        "closedEdgeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "description": "Nonempty UUID in lowercase canonical D format."
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "flightGates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NavigationFlightGate"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "navigationVersion",
        "graph",
        "checkpointBindings",
        "gateBindings",
        "accessProfiles",
        "closedZoneIds",
        "closedEdgeIds",
        "flightGates"
      ]
    },
    "NavigationPreviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passengerGeneration": {
          "$ref": "#/$defs/PassengerGenerationRequest"
        },
        "navigation": {
          "$ref": "#/$defs/NavigationInput"
        }
      },
      "required": [
        "passengerGeneration",
        "navigation"
      ]
    },
    "NavigationRouteQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "navigation": {
          "$ref": "#/$defs/NavigationConfig"
        },
        "fromZoneId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "toZoneId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "groupKind": {
          "type": "string",
          "enum": [
            "solo",
            "family",
            "business",
            "tour"
          ]
        }
      },
      "required": [
        "navigation",
        "fromZoneId",
        "toZoneId",
        "groupKind"
      ]
    },
    "NavigationWaypoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zoneId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "x": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "z": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "required": [
        "zoneId",
        "x",
        "y",
        "z"
      ]
    },
    "NavigationRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routeKey": {
          "type": "string",
          "pattern": "^nav-[0-9a-f]{24}$"
        },
        "flightId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "gateId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "checkpointId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "groupKind": {
          "type": "string",
          "enum": [
            "solo",
            "family",
            "business",
            "tour"
          ]
        },
        "zoneIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "description": "Nonempty UUID in lowercase canonical D format."
          },
          "minItems": 1,
          "maxItems": 2000
        },
        "edgeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "description": "Nonempty UUID in lowercase canonical D format."
          },
          "minItems": 0,
          "maxItems": 2000
        },
        "distanceMeters": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000000000
        },
        "baseWalkingMinutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 10080
        },
        "waypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NavigationWaypoint"
          },
          "minItems": 1,
          "maxItems": 2000
        },
        "passengerCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "routeKey",
        "flightId",
        "gateId",
        "checkpointId",
        "groupKind",
        "zoneIds",
        "edgeIds",
        "distanceMeters",
        "baseWalkingMinutes",
        "waypoints",
        "passengerCount"
      ]
    },
    "NavigationError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "checkpoint_zone_missing",
            "gate_zone_missing",
            "access_profile_missing",
            "zone_unavailable",
            "route_unreachable",
            "route_time_limit_exceeded"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "NavigationJourney": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^demo-pax-[0-9a-f]{32}-[0-9]{6}$"
        },
        "flightId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "gateId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "checkpointId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "routeKey": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^nav-[0-9a-f]{24}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/NavigationError"
            },
            {
              "type": "null"
            }
          ]
        },
        "walkingMinutes": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 10080
            },
            {
              "type": "null"
            }
          ]
        },
        "queueWaitMinutes": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "serviceMinutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 240
        },
        "arrivalMinute": {
          "type": "number",
          "minimum": 0,
          "maximum": 10080
        },
        "gateArrivalMinute": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "boardingCloseMinute": {
          "type": "number",
          "minimum": 0,
          "maximum": 10080
        },
        "boardingRisk": {
          "type": "string",
          "enum": [
            "pending",
            "safe",
            "late",
            "unserved",
            "unreachable"
          ]
        }
      },
      "required": [
        "id",
        "flightId",
        "gateId",
        "checkpointId",
        "routeKey",
        "error",
        "walkingMinutes",
        "queueWaitMinutes",
        "serviceMinutes",
        "arrivalMinute",
        "gateArrivalMinute",
        "boardingCloseMinute",
        "boardingRisk"
      ]
    },
    "NavigationFlightSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flightId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "gateId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "modeledCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "routedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "errorCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "safeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "lateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "unservedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "pendingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "meanWalkingMinutes": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 10080
            },
            {
              "type": "null"
            }
          ]
        },
        "meanQueueWaitMinutes": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "flightId",
