    "RoutedSimulationResponse": {
      "type": "object",
      "description": "Versioned simulation response. simulatedMinutes is actual simulated time, independent of wall clock; snapshots never exceed it. Result is the legacy shape without this field.",
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "1.0",
          "description": "Wire protocol version; every envelope must explicitly provide it."
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed"
          ]
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ZoneSnapshot"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "simulatedMinutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 10080,
          "description": "Actual simulated minutes since startsAtUtc; completed runs must advance time. Not execution time in seconds."
        },
        "navigationResult": {
          "$ref": "#/$defs/NavigationResult"
        }
      },
      "required": [
        "contractVersion",
        "runId",
        "status",
        "metrics",
        "snapshots",
        "failure",
        "simulatedMinutes",
        "navigationResult"
      ]
