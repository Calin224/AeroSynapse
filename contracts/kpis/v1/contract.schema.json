              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "zoneId",
        "zoneType",
        "minute",
        "arrivedPassengers",
        "queuedPassengers",
        "processingPassengers",
        "processedPassengers",
        "walkingPassengers",
        "maximumQueue",
        "meanWaitMinutes",
        "medianWaitMinutes",
        "p95WaitMinutes",
        "capacity",
