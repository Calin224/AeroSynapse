              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractScenarioSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Invalid contract or malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractValidationError"
                }
              }
