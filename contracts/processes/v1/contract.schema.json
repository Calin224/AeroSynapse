{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerosynapse.example/contracts/processes/1.0/contract.schema.json",
  "title": "SimPy definitions; bundled with v1, passenger and navigation definitions",
  "$defs": {
    "SimPySimulationRequest": {
      "type": "object",
      "description": "Version 1 queue simulation input, copied from frozen inputs. No live database references are resolved by validation.",
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "1.0",
          "description": "Wire protocol version; every envelope must explicitly provide it."
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "scenarioId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "scenarioRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Captured scenario revision."
        },
        "layoutVersionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "startsAtUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
          "description": "Gregorian UTC timestamp, uppercase T/Z, at most 6 fractional digits; no leap seconds."
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "IANA display time zone, e.g. UTC or Europe/Bucharest; all instants stay UTC."
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080,
          "description": "Simulation horizon in minutes, 1 minute = 60 seconds."
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "Explicit reproducibility seed; no implicit default in v1."
        },
        "passengerCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "arrivalRatePerMinute": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Checkpoint"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "engine": {
          "type": "string",
          "const": "simpy-1.0"
        },
        "passengerGeneration": {
          "$ref": "#/$defs/PassengerGenerationRequest"
        },
        "navigation": {
          "$ref": "#/$defs/NavigationInput"
        }
      },
      "required": [
        "contractVersion",
        "runId",
        "scenarioId",
        "scenarioRevision",
        "layoutVersionId",
        "startsAtUtc",
        "timeZone",
        "durationMinutes",
        "seed",
        "passengerCount",
        "arrivalRatePerMinute",
        "checkpoints",
        "engine"
      ]
    },
    "SimPyScenarioSnapshot": {
      "type": "object",
      "description": "Versioned frozen queue simulation inputs. Independent of a run; ToSimulationRequest assigns runId without reading mutable data. capturedAtUtc records capture time, not simulation start.",
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "1.0",
          "description": "Wire protocol version; every envelope must explicitly provide it."
        },
        "scenarioId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "scenarioRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Captured scenario revision."
        },
        "layoutVersionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "startsAtUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
          "description": "Gregorian UTC timestamp, uppercase T/Z, at most 6 fractional digits; no leap seconds."
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "IANA display time zone, e.g. UTC or Europe/Bucharest; all instants stay UTC."
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080,
          "description": "Simulation horizon in minutes, 1 minute = 60 seconds."
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "Explicit reproducibility seed; no implicit default in v1."
        },
        "passengerCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "arrivalRatePerMinute": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Checkpoint"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "capturedAtUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
          "description": "Gregorian UTC timestamp, uppercase T/Z, at most 6 fractional digits; no leap seconds."
        },
        "engine": {
          "type": "string",
          "const": "simpy-1.0"
        },
        "passengerGeneration": {
          "$ref": "#/$defs/PassengerGenerationRequest"
        },
        "navigation": {
          "$ref": "#/$defs/NavigationInput"
        }
      },
      "required": [
        "contractVersion",
        "scenarioId",
        "scenarioRevision",
        "layoutVersionId",
        "startsAtUtc",
        "timeZone",
        "durationMinutes",
        "seed",
        "passengerCount",
        "arrivalRatePerMinute",
        "checkpoints",
        "capturedAtUtc",
        "engine"
      ]
    },
    "ProcessPassenger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^demo-(pax|queue|surge)-[0-9a-f]{32}-[0-9]{6}$"
        },
        "checkpointId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "flightId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              },
              "description": "Nonempty UUID in lowercase canonical D format."
            },
            {
              "type": "null"
            }
          ]
        },
        "gateId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              },
              "description": "Nonempty UUID in lowercase canonical D format."
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "queued",
            "processing",
            "walking",
            "at_gate",
            "unreachable"
          ]
        },
        "arrivalMinute": {
          "type": "number",
          "minimum": 0,
          "maximum": 10080
        },
        "serviceMinutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "walkingMinutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 10080
        },
        "boardingCloseMinute": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 10080
            },
            {
              "type": "null"
            }
          ]
        },
        "queueEnteredMinute": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 10080
            },
            {
              "type": "null"
            }
          ]
        },
        "processingStartedMinute": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 10080
            },
            {
              "type": "null"
            }
          ]
        },
        "securityClearedMinute": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 10080
            },
            {
              "type": "null"
            }
          ]
        },
        "gateArrivalMinute": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 10080
            },
            {
              "type": "null"
            }
          ]
        },
        "queueWaitMinutes": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 10080
            },
            {
              "type": "null"
            }
          ]
        },
        "boardingRisk": {
          "type": "string",
          "enum": [
            "not_applicable",
            "pending",
            "safe",
            "late",
            "missed",
            "unreachable"
          ]
        },
        "deadlineMissed": {
          "type": "boolean"
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "assignedCheckpointId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Control the passenger was assigned to when an unavailable control redirected the arrival."
        },
        "routeHoldMinutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 10080,
          "description": "Minutes waited at the control exit because corridor closures left no navigable route."
        },
        "awaitingRoute": {
          "type": "boolean",
          "const": true,
          "description": "Still waiting for a navigable route at the horizon; walkingMinutes is then 0."
        }
      },
      "required": [
        "id",
        "checkpointId",
        "flightId",
        "gateId",
        "stage",
        "arrivalMinute",
        "serviceMinutes",
        "walkingMinutes",
        "boardingCloseMinute",
        "queueEnteredMinute",
        "processingStartedMinute",
        "securityClearedMinute",
        "gateArrivalMinute",
        "queueWaitMinutes",
        "boardingRisk",
        "deadlineMissed",
        "errorCode"
      ]
    },
    "ProcessCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpointId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "capacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "peakBusy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "peakQueue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "arrivedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "queuedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "processingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "processedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "meanWaitMinutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 10080
        }
      },
      "required": [
        "checkpointId",
        "capacity",
        "peakBusy",
        "peakQueue",
        "arrivedCount",
        "queuedCount",
        "processingCount",
        "processedCount",
        "meanWaitMinutes"
      ]
    },
    "ProcessResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "processVersion": {
          "type": "string",
          "const": "1.0"
        },
        "engine": {
          "type": "string",
          "const": "simpy-1.0"
        },
        "mode": {
          "type": "string",
          "enum": [
            "flight_profiles",
            "aggregate"
          ]
        },
        "horizonMinutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 10080
        },
        "populationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "arrivedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "notArrivedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "queuedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "processingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "walkingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "atGateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "unreachableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "deadlineMissedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProcessCheckpoint"
          },
          "maxItems": 1000
        },
        "passengers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProcessPassenger"
          },
          "maxItems": 100000
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "returnedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "hasMore": {
          "type": "boolean"
        }
      },
      "required": [
        "processVersion",
        "engine",
        "mode",
        "horizonMinutes",
        "populationCount",
        "arrivedCount",
        "notArrivedCount",
        "queuedCount",
        "processingCount",
        "walkingCount",
        "atGateCount",
        "unreachableCount",
        "deadlineMissedCount",
        "checkpoints",
        "passengers",
        "offset",
        "returnedCount",
        "hasMore"
      ]
    },
    "SimPySimulationResponse": {
      "type": "object",
      "description": "Versioned simulation response. simulatedMinutes is actual simulated time, independent of wall clock; snapshots never exceed it. Result is the legacy shape without this field.",
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "1.0",
          "description": "Wire protocol version; every envelope must explicitly provide it."
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "description": "Nonempty UUID in lowercase canonical D format."
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed"
          ]
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ZoneSnapshot"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "simulatedMinutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 10080,
          "description": "Actual simulated minutes since startsAtUtc; completed runs must advance time. Not execution time in seconds."
        },
        "processResult": {
          "$ref": "#/$defs/ProcessResult"
        },
        "navigationResult": {
          "$ref": "#/$defs/NavigationResult"
        }
      },
      "required": [
        "contractVersion",
        "runId",
        "status",
        "metrics",
        "snapshots",
        "failure",
        "simulatedMinutes",
        "processResult"
      ]
    }
  }
}
