      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ready",
            "warming",
            "unavailable"
          ]
        },
        "contractVersion": {
          "const": "1.0"
        },
        "dataScope": {
          "const": "aggregate_synthetic"
