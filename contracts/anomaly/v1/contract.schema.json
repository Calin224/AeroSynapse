        "falsePositiveRate": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "medianDelayMinutes": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 10080
            },
            {
              "type": "null"
            }
          ]
        },
        "preOnsetAlerts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "confusion",
        "recall",
        "falsePositiveRate",
        "precision",
        "medianDelayMinutes",
        "preOnsetAlerts"
      ]
    },
    "AnomalySweepPoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
