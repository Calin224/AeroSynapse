              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "true_negative": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "true_positive",
            "false_negative",
            "false_positive",
            "true_negative"
          ]
        },
        "recall": {
          "anyOf": [
