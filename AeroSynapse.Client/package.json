{
  "name": "aero-synapse.client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/start.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:console": "tsc --project tsconfig.e2e.json && playwright test",
    "test:critical-e2e": "tsc --project tsconfig.e2e.json && playwright test --config=playwright.critical.config.ts",
    "test:readiness": "tsc --project tsconfig.e2e.json && playwright test --config=playwright.readiness.config.ts",
    "verify:assets": "node scripts/verify-airport-assets.mjs",
    "verify:replay-shell": "node scripts/verify-replay-shell.mjs"
  },
  "private": true,
  "packageManager": "npm@12.2.0",
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "21.2.25",
    "@fontsource-variable/host-grotesk": "5.3.0",
    "@microsoft/signalr": "^10.0.11",
    "@primeuix/themes": "2.0.3",
    "primeicons": "^8.0.2",
    "primeng": "21.1.10",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.3",
    "vitest": "^4.0.8"
  }
}
