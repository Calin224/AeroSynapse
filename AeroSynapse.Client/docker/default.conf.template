log_format aerosynapse_safe '$remote_addr [$time_iso8601] "$request_method $uri $server_protocol" $status $body_bytes_sent rt=$request_time';

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    access_log /dev/stdout aerosynapse_safe;
    error_log /dev/stderr warn;

    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"Healthy","service":"frontend"}';
    }
    location /api/airports {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }
    location /api/hubs/operations {
        proxy_pass http://${API_UPSTREAM}/hubs/operations;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }
    location /api/ {
        proxy_pass http://${API_UPSTREAM}/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        # Staffing evaluations solve CP-SAT and shift plans before answering (about 30 s); the
        # browser waits 45 s (OPERATION_REQUEST_TIMEOUT_MS), so the proxy must wait longer.
        proxy_read_timeout 50s;
    }
    location /intelligence/ {
        proxy_pass http://${API_UPSTREAM}/intelligence/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 50s;
    }
    location = /runtime-config.js {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }
    location = /ngsw.json {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location = /ngsw-worker.js {
        add_header Cache-Control "no-cache";
        add_header Service-Worker-Allowed "/";
        try_files $uri =404;
    }
    location /data/ {
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
