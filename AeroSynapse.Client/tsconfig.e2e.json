{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "e2e/**/*.ts",
    "playwright.config.ts",
    "playwright.critical.config.ts",
    "playwright.readiness.config.ts"
  ]
}
